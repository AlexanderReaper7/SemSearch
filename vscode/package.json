{
  "name": "semsearch",
  "displayName": "SemSearch",
  "description": "Semantic search over code, files and web history through semsearch and the local hister instance",
  "version": "0.1.2",
  "publisher": "local",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/AlexanderReaper7/SemSearch" },
  "icon": "icon.png",
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "semsearch.code", "title": "SemSearch: Code" },
      { "command": "semsearch.all", "title": "SemSearch: Everything" }
    ],
    "keybindings": [
      { "command": "semsearch.code", "key": "ctrl+alt+f" }
    ],
    "configuration": {
      "title": "SemSearch",
      "properties": {
        "semsearch.binary": {
          "type": "string",
          "default": "",
          "description": "Path to semsearch, such as a dev build. Empty means semsearch on PATH."
        },
        "semsearch.watch": {
          "type": "boolean",
          "default": true,
          "description": "Re-index an open folder's code 10 s after a file in it changes."
        }
      }
    }
  }
}
