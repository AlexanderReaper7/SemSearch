{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SemSearch",
  "version": "0.1.0",
  "identifier": "io.github.alexanderreaper7.semsearch",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5199/app.html",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "app.html",
        "title": "SemSearch",
        "width": 760,
        "height": 520,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
